# Copie para .env antes de subir o ambiente:  cp .env.example .env
# São credenciais só de desenvolvimento local; o .env não é versionado.

# PostgreSQL (R1)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace123
POSTGRES_DB=marketplace

# Redis (R3, R4, R5, R8)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=marketplace123

# MongoDB (R2)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=marketplace
MONGO_PASSWORD=marketplace123
MONGO_DB=marketplace

# Cassandra (R6) — a imagem oficial vem sem autenticação (AllowAllAuthenticator)
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=marketplace

# Neo4j (R7) — a senha precisa ter pelo menos 8 caracteres
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=marketplace123
